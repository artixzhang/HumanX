<?xml version="1.0" ?>
<robot name="ball">
  <link name="ball">
    <inertial>
      <mass value="0.6"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.12"/>
          <!--<mesh filename="meshes/ball.obj"/>-->
      </geometry>
      <material name="Grey">
        <color rgba="0.65 0.65 0.65 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.12"/>
        <!--<mesh filename="meshes/ball.obj"/>-->
      </geometry>
    </collision>
  </link>
</robot>
